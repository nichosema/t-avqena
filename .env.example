# Tavqena social integrations
# Add real values only in your hosting provider's Environment Variables.
# Never commit real tokens or secrets.

META_VERIFY_TOKEN=replace-with-a-random-private-value
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-access-token
META_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
FACEBOOK_PAGE_ID=your-facebook-page-id

# Optional AI integration — leave blank while building the product without AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
